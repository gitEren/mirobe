{
  "expo": {
    "name": "Mirobe",
    "slug": "mirobe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mirobe",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/mirobe.icon",
      "bundleIdentifier": "com.orbexastudio.mirobe",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "F293R6XW2Y"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A1918",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.orbexastudio.mirobe"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF9F5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 136
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Mirobe k\u0131yafetlerini taramak ve ayna foto\u011fraf\u0131n\u0131 \u00e7ekmek i\u00e7in kameray\u0131 kullan\u0131r.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Mirobe galerindeki k\u0131yafet foto\u011fraflar\u0131n\u0131 gard\u0131roba eklemek i\u00e7in foto\u011fraflar\u0131na eri\u015fir."
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      "expo-localization",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Jev\u2019e sesli kombin iste\u011fi g\u00f6ndermek i\u00e7in mikrofonu kullan\u0131r.",
          "speechRecognitionPermission": "Sesli iste\u011fini metne \u00e7evirmek i\u00e7in konu\u015fma tan\u0131ma kullan\u0131l\u0131r."
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Mirobe k\u0131yafetlerini taramak ve ayna foto\u011fraf\u0131n\u0131 \u00e7ekmek i\u00e7in kameray\u0131 kullan\u0131r.",
          "microphonePermission": "Jev\u2019e sesli kombin iste\u011fi g\u00f6ndermek i\u00e7in mikrofonu kullan\u0131r."
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#1A1918"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
