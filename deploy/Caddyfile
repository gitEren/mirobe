# Mirobe edge proxy (used only with COMPOSE_PROFILES=caddy).
#
# Cloudflare (orange cloud, SSL "Full (strict)") is the only client this proxy talks to:
# - TLS uses a Cloudflare Origin CA certificate mounted from deploy/certs/ (server-side only,
#   gitignored, excluded from deploy.sh rsync). Browsers would not trust it; Cloudflare does.
# - Every request whose TCP peer is not a Cloudflare IP is aborted, so the origin cannot be
#   used to bypass Cloudflare's WAF/rate limits. Refresh the ranges from
#   https://www.cloudflare.com/ips-v4 and /ips-v6 when Cloudflare announces changes.
# - Plain HTTP is only a redirect; Cloudflare "Always Use HTTPS" normally answers it first.

{
	auto_https disable_redirects
	skip_install_trust
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
		timeouts {
			read_body 60s
			read_header 15s
			write 180s
			idle 120s
		}
	}
}

(cf_only) {
	# remote_ip matches the TCP peer, so a forged CF-Connecting-IP header cannot pass.
	@notcf not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	abort @notcf
}

(mirobe_proxy) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=15552000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		-Server
		-Via
	}
	# Only image uploads (data URLs) are large; everything else is small JSON.
	@upload path /api/media
	request_body @upload {
		max_size 25MB
	}
	@notupload not path /api/media
	request_body @notupload {
		max_size 2MB
	}
	reverse_proxy api:3000 {
		# Cloudflare cuts requests at ~100 s and the API caps provider calls below that,
		# so the origin never cuts first.
		transport http {
			dial_timeout 5s
			response_header_timeout 150s
			read_timeout 150s
			write_timeout 150s
		}
		health_uri /api/health
		health_interval 5s
		# During a deploy the API restarts for a few seconds; hold requests and retry
		# instead of answering 503.
		lb_try_duration 30s
		lb_try_interval 500ms
	}
	log {
		output stdout
		format console
	}
}

mirobe.orbexastudio.com.tr {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem
	import cf_only
	import mirobe_proxy
}

http://mirobe.orbexastudio.com.tr {
	import cf_only
	redir https://{host}{uri} 308
}

# Anything else (bare IP, unknown Host headers): drop the connection.
http:// {
	abort
}
