# ---------------------------------------------------------------------------
# Server (server/). Never prefix these with EXPO_PUBLIC_ — they must not ship
# inside the mobile app.
# ---------------------------------------------------------------------------

# OpenRouter: vision tagging, packshots, photo try-on and Jev decisions.
# Paid models need credits on the OpenRouter account. When they run out, paid calls are
# refunded, the app says AI features are temporarily unavailable, and the server logs
# "[mirobe] ALERT: AI provider out of credits" at most every 10 minutes.
OPENROUTER_API_KEY=""
OPENROUTER_VISION_MODEL="google/gemini-3.1-flash-lite"
# Packshots (studio image of a worn garment), rendered on request, not on every scan.
OPENROUTER_IMAGE_MODEL="google/gemini-3.1-flash-lite-image"
# Photo try-on. Set it explicitly: when empty it falls back to OPENROUTER_IMAGE_MODEL.
# Gemini Flash Lite image: ~$0.035, ~28 s (chosen after an A/B test on 2026-09-23). Gemini Flash image: ~$0.068, ~32 s.
OPENROUTER_TRYON_MODEL="google/gemini-3.1-flash-lite-image"
# Jev runs on the alpha Decisions endpoint (/api/alpha/decisions).
JEV_MODEL="typesafe/jev-1.13"

# 5 s motion clips. Default: OpenRouter Seedance 1.5 Pro without audio
# (720p ~ $0.13, 480p ~ $0.058 per clip). VIDEO_PROVIDER="fal" switches to fal Kling ($0.35).
VIDEO_PROVIDER="openrouter"
OPENROUTER_VIDEO_MODEL="bytedance/seedance-1-5-pro"
# Render resolution only: a clip counts as one of the plan's videos either way.
VIDEO_RESOLUTION="480p"

# Live mirror (fal realtime). Off by default: no plan includes it, the app hides it and
# every /api/live route answers 404 FEATURE_DISABLED. "true" switches the server side on
# again (a session then counts as one video); the app also needs LIVE_MIRROR_ENABLED
# in shared/src/features.ts.
LIVE_MIRROR_ENABLED="false"

# fal.ai: only needed for the live mirror (decart/lucy2-vton, $0.02/s) and VIDEO_PROVIDER="fal".
FAL_KEY=""
FAL_VIDEO_MODEL="fal-ai/kling-video/v2.5-turbo/pro/image-to-video"

# RevenueCat secret API key (v1) so the server can verify subscriptions.
REVENUECAT_SECRET_KEY=""
# Set together with a v2 secret key (v2 keys are project scoped, e.g. "projec0e66d8"). Leave empty for a legacy v1 key.
REVENUECAT_PROJECT_ID=""
# Shared secret RevenueCat sends as the Authorization header of every webhook
# (RevenueCat → Integrations → Webhooks). Webhooks are refused (401) while empty.
# Generate with: openssl rand -hex 32
REVENUECAT_WEBHOOK_AUTH=""

# Push notifications (payment received / payment failed) over APNs. Apple Developer →
# Keys → a key with "Apple Push Notifications service (APNs)" → download AuthKey_<KEYID>.p8.
# One key serves both the sandbox (development builds) and production. Push is off
# (logged once, nothing else changes) while APNS_KEY_ID or APNS_KEY_BASE64 is empty.
APNS_KEY_ID=""
APNS_TEAM_ID="F293R6XW2Y"
# The whole .p8 file base64-encoded on one line: base64 -i AuthKey_<KEYID>.p8 | tr -d '\n'
APNS_KEY_BASE64=""
# apns-topic: the iOS bundle id.
APNS_TOPIC="com.orbexastudio.mirobe"

# Android push (same payment notices) over FCM HTTP v1. Firebase console → Project settings →
# Service accounts → Generate new private key (a JSON file). Android push is off (logged once,
# iOS keeps working) while empty. The whole JSON base64-encoded on one line:
#   base64 -i service-account.json | tr -d '\n'     (Linux: base64 -w0 service-account.json)
FCM_SERVICE_ACCOUNT_BASE64=""
# Optional: overrides the service account's project_id.
FCM_PROJECT_ID=""

# Local testing only (ignored when NODE_ENV=production): pretend every user
# has this plan while RevenueCat is not configured. "plus" or "pro"
# ("premium" is accepted as the old name of "plus"). Motion clips need "pro".
DEV_PLAN_OVERRIDE=""

# Login/register attempts allowed per client IP and per email every 15 minutes.
AUTH_RATE_LIMIT="10"

PORT=3000
# SQLite database and media files. Mount a volume here in production.
DATA_DIR=""
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Mobile (mobile/). Public values baked into the app bundle.
# Put these in mobile/.env or in eas.json build profiles.
# ---------------------------------------------------------------------------
# Leave empty in development: the app reuses the Metro host (your Mac's LAN IP).
EXPO_PUBLIC_API_URL=""
# RevenueCat public SDK keys (appl_… / goog_…). Empty: the paywall shows prices but no buy buttons.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=""
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=""
