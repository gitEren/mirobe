# fal.ai only on the server. Never expose this value to the mobile client.
FAL_KEY="MY_FAL_KEY"

# Jev adapter. Keep the OpenRouter key server-side and choose the model per environment.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"
JEV_MODEL="typesafe/jev"
OPENROUTER_VISION_MODEL="google/gemini-2.5-flash"
OPENROUTER_IMAGE_MODEL="google/gemini-3.1-flash-image"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="SERVER_ONLY"
SUPABASE_STORAGE_BUCKET="mirobe-media"

# Public RevenueCat SDK keys. Keep secret StoreKit/Play credentials in RevenueCat,
# not in this file. Product identifiers must match PACKAGE_IDS in billingService.ts.
VITE_REVENUECAT_IOS_API_KEY="appl_..."
VITE_REVENUECAT_ANDROID_API_KEY="goog_..."

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
