    "@google/genai": "^2.4.0",
    "@gradio/client": "^2.7.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@revenuecat/purchases-capacitor": "^13.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
