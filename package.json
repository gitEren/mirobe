{
  "name": "mirobe",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "mobile"
  ],
  "scripts": {
    "server": "npm run dev -w @mirobe/server",
    "mobile": "npm run start -w mobile",
    "test": "npm test -w @mirobe/server",
    "lint": "npm run lint -w @mirobe/server && npm run lint -w mobile"
  },
  "devDependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom"
  }
}